  "slides": [
    {
      "id": "animals",
      "text": "Think of two animals. One swings its horns up. One swipes its paw down.",
      "defines": [],
      "title": "Two animals",
      "art": "bull"
    },
    {
      "id": "bull",
      "text": "A bull thinks prices will rise. In a bull market, prices rise for a long time.",
      "defines": ["bull"],
      "title": "Bulls",
      "art": "bull"
    },
    {
      "id": "bear",
      "text": "A bear thinks prices will fall. In a bear market, prices fall for a long time.",
